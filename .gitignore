# =============================================================================
# Civic Services Platform — .gitignore
# Python | Vue | Node | VS Code | OS
# =============================================================================

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/
*.pyo

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# Flask
instance/
.webassets-cache

# SQLite database files
*.db
*.sqlite
*.sqlite3

# Migrations (keep folder, ignore auto-generated)
# backend/migrations/versions/  <- tracked intentionally

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/

# Pytype
.pytype/

# Celery
celerybeat-schedule
celerybeat.pid

# =============================================================================
# Node / Vue / Frontend
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite build output
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# Nuxt
.nuxt/
.output/

# Local env files (all variants)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Parcel cache
.parcel-cache/

# Storybook
storybook-static/

# =============================================================================
# VS Code
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# =============================================================================
# JetBrains IDEs
# =============================================================================
.idea/
*.iws
*.iml
*.ipr

# =============================================================================
# macOS
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# =============================================================================
# Windows
# =============================================================================
Thumbs.db
Thumbs.db:encdata
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# =============================================================================
# Linux
# =============================================================================
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# Logs
# =============================================================================
logs/
*.log
*.log.*

# =============================================================================
# Secrets — never commit these
# =============================================================================
*.pem
*.key
*.cert
*.crt
secrets/
.secrets
