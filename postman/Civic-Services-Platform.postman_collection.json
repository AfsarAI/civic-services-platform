            "url": "{{base_url}}/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Locations",
      "item": [
        {
          "name": "Lookup Pincode",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/locations/pincode/226001",
            "description": "Public. Resolve a 6-digit pincode to matching city option(s)."
          }
        },
        {
          "name": "Search Cities",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/locations/cities?query=luck&limit=10",
            "description": "Public. City autosuggest."
          }
        },
        {
          "name": "Search Pincodes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/locations/pincodes?prefix=22&limit=10",
            "description": "Public. Pincode autocomplete (min 2 digits)."
          }
        },
        {
          "name": "Reverse Geocode",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/locations/reverse-geocode?lat=26.8467&lon=80.9462",
            "description": "Public. Map pin -> address/pincode/city."
          }
        },
        {
          "name": "Public Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/locations/overview",
            "description": "Public. Landing-page stats."
          }
        },
        {
          "name": "Public Complaint Pins",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/locations/complaint-pins?limit=100",
            "description": "Public. Map markers from stored complaint coordinates."
          }
        }
      ]
    },
    {
      "name": "System Settings",
      "item": [
        {
          "name": "Get System Settings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/settings",
            "description": "System Admin only."
          }
        },
        {
          "name": "Update System Settings",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/settings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maintenance_mode\": false,\n  \"notify_on_status_change\": true,\n  \"default_complaint_priority\": \"medium\"\n}"
            },
            "description": "System Admin only. Audit-logged."
          }
        }
      ]
    }
  ]
}
