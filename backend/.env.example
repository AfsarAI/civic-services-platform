FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

SECRET_KEY=change-me-to-a-random-secret-key
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret

# DATABASE_URL — leave blank for SQLite (config.py builds an absolute path).
# Set this only when using PostgreSQL or MySQL in staging/production.
# DATABASE_URL=postgresql://user:pass@localhost:5432/civic_db
#
# Azure Database for PostgreSQL (production) — flexible server requires SSL:
# DATABASE_URL=postgresql://<user>:<password>@<server-name>.postgres.database.azure.com:5432/civic_db?sslmode=require

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (Azure App Service), set CORS_ORIGINS to the GitHub Pages origin only, e.g.:
# CORS_ORIGINS=https://<github-username>.github.io

# Seed admin credentials (used by: flask seed)
ADMIN_EMAIL=admin@civicservices.local
ADMIN_PASSWORD=Admin@123456
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
