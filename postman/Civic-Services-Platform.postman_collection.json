{
  "info": {
    "_postman_id": "civic-services-platform-v1",
    "name": "Civic Services Platform API",
    "description": "Complete API collection for the Civic Services Platform.\n\nBase URL: http://localhost:5000/api/v1\n\nAuthentication: Bearer JWT token in Authorization header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"citizen1\",\n  \"email\": \"citizen@example.com\",\n  \"password\": \"Password123\",\n  \"first_name\": \"Alice\",\n  \"last_name\": \"Smith\",\n  \"role_id\": 1\n}"
            },
            "description": "Register a new user account."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', json.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', json.data.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "description": "Authenticate and receive JWT tokens."
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/auth/me",
            "description": "Get the authenticated user's profile."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{refresh_token}}" }],
            "url": "{{base_url}}/auth/refresh",
            "description": "Refresh the access token."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/auth/logout",
            "description": "Invalidate the current token."
          }
        }
      ]
    },
    {
      "name": "Citizen",
      "item": [
        {
          "name": "Get My Complaints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/citizen/complaints",
            "description": "Retrieve all complaints for the authenticated citizen."
          }
        },
        {
          "name": "Submit Complaint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/citizen/complaints",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Large pothole on Main Street\",\n  \"description\": \"There is a large pothole approximately 30cm wide causing traffic hazards.\",\n  \"category\": \"pothole\",\n  \"priority\": \"high\",\n  \"address\": \"123 Main Street, City\",\n  \"latitude\": -33.8688,\n  \"longitude\": 151.2093\n}"
            },
            "description": "Submit a new civic complaint."
          }
        },
        {
          "name": "Get Complaint by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/citizen/complaints/1",
            "description": "Retrieve a specific complaint by ID."
          }
        },
        {
          "name": "Citizen Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/citizen/dashboard",
            "description": "Get citizen dashboard summary."
          }
        },
        {
          "name": "Submit Feedback",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/citizen/complaints/1/feedback",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Issue resolved promptly. Great service!\"\n}"
            },
            "description": "Submit feedback for a resolved complaint."
          }
        }
      ]
    },
    {
      "name": "Administrator",
      "item": [
        {
          "name": "Get All Complaints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/complaints",
            "description": "Retrieve all complaints (admin access required)."
          }
        },
        {
          "name": "Assign Complaint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/complaints/1/assign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"worker_id\": 3,\n  \"notes\": \"Please inspect and repair by end of week.\"\n}"
            },
            "description": "Assign a complaint to a field worker."
          }
        },
        {
          "name": "Admin Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/dashboard",
            "description": "Get administrator dashboard statistics."
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/users",
            "description": "Retrieve all platform users."
          }
        },
        {
          "name": "Get Field Workers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/field-workers",
            "description": "Get all field workers for assignment."
          }
        },
        {
          "name": "Reset User Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/users/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewSecret@123\",\n  \"confirm_password\": \"NewSecret@123\"\n}"
            },
            "description": "Reset a user's password (System Admin: any user; Municipal Admin: citizens in their own city only). Also accepts email/first_name/last_name/phone/is_active."
          }
        },
        {
          "name": "Update User Email",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/users/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"updated.citizen@example.com\"\n}"
            },
            "description": "Change a user's email. Returns 409 if the email is already in use by another account."
          }
        },
        {
          "name": "Reset Field Worker Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/field-workers/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewWorker@123\",\n  \"confirm_password\": \"NewWorker@123\"\n}"
            },
            "description": "Reset a field worker's password (Municipal Admin only, scoped to their own city)."
          }
        },
        {
          "name": "Get Municipal Administrators",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/admin/municipal-administrators",
            "description": "List municipal administrators (System Admin only)."
          }
        },
        {
          "name": "Create Municipal Administrator",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/municipal-administrators",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"lucknow_admin\",\n  \"email\": \"lucknow.admin@example.com\",\n  \"password\": \"Municipal@123\",\n  \"confirm_password\": \"Municipal@123\",\n  \"first_name\": \"Lucknow\",\n  \"last_name\": \"Admin\",\n  \"pincode\": \"226001\"\n}"
            },
            "description": "Register a new Municipal Administrator (System Admin only)."
          }
        },
        {
          "name": "Reset Municipal Administrator Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/municipal-administrators/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewMunicipal@123\",\n  \"confirm_password\": \"NewMunicipal@123\"\n}"
            },
            "description": "Reset a municipal administrator's password (System Admin only)."
          }
        }
      ]
    },
    {
      "name": "Field Worker",
      "item": [
        {
          "name": "Get My Assignments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/fieldworker/assignments",
            "description": "Retrieve all assignments for the authenticated field worker."
          }
        },
        {
          "name": "Accept Assignment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/fieldworker/assignments/1/accept",
            "description": "Accept an assigned task."
          }
        },
        {
          "name": "Update Progress",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/fieldworker/assignments/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\",\n  \"notes\": \"Started repair work. Materials delivered.\"\n}"
            },
            "description": "Update repair progress for an assignment."
          }
        },
        {
          "name": "Complete Assignment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/fieldworker/assignments/1/complete",
            "description": "Mark an assignment as completed."
          }
        },
        {
          "name": "Field Worker Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/fieldworker/dashboard",
            "description": "Get field worker dashboard summary."
          }
        }
      ]
    },
    {
